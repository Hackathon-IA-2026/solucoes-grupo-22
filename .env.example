# Configuração do EnergyNexus nesta máquina. ./instalar.sh copia este arquivo para .env e gera os segredos.
# O LibreChat lê este mesmo arquivo (ele está na raiz do LibreChat).

# ---- LibreChat
APP_TITLE=EnergyNexus
CUSTOM_FOOTER="EnergyNexus — o ponto de conexão da inteligência sobre o setor energético"
HOST=127.0.0.1
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
MEILI_HOST=http://127.0.0.1:7700
SEARCH=true
MEILI_NO_ANALYTICS=true
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
BAN_VIOLATIONS=false
ENDPOINTS=custom,agents,bedrock
# nome e rodapé da marca: o LibreChat devolve os dois em /api/config (título da aba, e-mails, rodapé do chat)
APP_TITLE=EnergyNexus
CUSTOM_FOOTER=EnergyNexus — dados públicos da CVM, ANEEL, ONS, BNDES e EPE
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# ---- aba Busca: porta local do proper_mcps/docs/busca.py (o iniciar.sh sobe, o LibreChat repassa /api/busca)
BUSCA_PORTA=8766

# ---- modelo próprio (vLLM, ./vllm.sh): endereço que o LibreChat usa e chave que o vLLM exige
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
VLLM_MODELO=RedHatAI/Qwen3.8-27B-INT4
VLLM_PORTA=8001

# ---- modelo da AWS (Bedrock): credenciais em ~/.aws/credentials (ou BEDROCK_AWS_BEARER_TOKEN)
BEDROCK_AWS_DEFAULT_REGION=us-east-1

# ---- MCP na AWS (proper_mcps/agentcore/atualizar.py): usuário do Cognito que os runtimes aceitam, para o token JWT
COGNITO_USUARIO=
COGNITO_SENHA=

# ---- busca web nativa do LibreChat (opcional)
SERPER_API_KEY=
JINA_API_KEY=

# ---- servidores MCP no Amazon Bedrock AgentCore (proper_mcps/agentcore/ponte.py faz a ponte stdio e cuida do token)
# Prazo do boot para inicializar cada servidor MCP. O padrão de 30 s não basta: cada pedido ao AgentCore leva de 5 a
# 14 s e o boot faz dois (initialize e tools/list). Estourando, o servidor fica sem ferramentas por 5 min.
MCP_INIT_TIMEOUT_MS=180000
ENERGYNEXUS_AGENTCORE_REGIAO=us-west-2
ENERGYNEXUS_ARN_DADOS=
ENERGYNEXUS_ARN_DOCS=
ENERGYNEXUS_ARN_RELATORIO=
# Pool do Cognito que autoriza os runtimes. Ele não tem domínio nem segredo de cliente, então o único fluxo possível é
# usuário e senha (USER_PASSWORD_AUTH); o token vale 24 h e a ponte o renova sozinha. A senha fica só aqui.
ENERGYNEXUS_COGNITO_REGIAO=us-east-1
ENERGYNEXUS_COGNITO_CLIENTE=
ENERGYNEXUS_COGNITO_USUARIO=
ENERGYNEXUS_COGNITO_SENHA=
