# Configuração do CoppeZIP nesta máquina. ./instalar.sh copia este arquivo para .env e gera os segredos.
# O LibreChat lê este mesmo arquivo (ele está na raiz do LibreChat).

# ---- LibreChat
HOST=127.0.0.1
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
MEILI_HOST=http://127.0.0.1:7700
SEARCH=true
MEILI_NO_ANALYTICS=true
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
BAN_VIOLATIONS=false
ENDPOINTS=custom,agents,bedrock
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# ---- aba Busca: porta local do proper_mcps/docs/busca.py (o iniciar.sh sobe, o LibreChat repassa /api/busca)
BUSCA_PORTA=8766

# ---- modelo próprio (vLLM, ./vllm.sh): endereço que o LibreChat usa e chave que o vLLM exige
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
VLLM_MODELO=RedHatAI/Qwen3.8-27B-INT4
VLLM_PORTA=8001

# ---- modelo da AWS (Bedrock): credenciais em ~/.aws/credentials (ou BEDROCK_AWS_BEARER_TOKEN)
BEDROCK_AWS_DEFAULT_REGION=us-east-1

# ---- MCP na AWS (proper_mcps/agentcore/atualizar.py): usuário do Cognito que os runtimes aceitam, para o token JWT
COGNITO_USUARIO=
COGNITO_SENHA=

# ---- busca web nativa do LibreChat (opcional)
SERPER_API_KEY=
JINA_API_KEY=
